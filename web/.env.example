# --- POP Workflow UI ---
# All values are optional. Defaults work for local development.

# Where the existing POP APIs live, used by the "Use live decision service"
# toggle. Empty = same origin (correct in production, where Express serves the
# UI and the APIs together). Leave unset locally and let the Vite proxy handle it.
# VITE_API_BASE_URL=

# Dev-only: where Vite forwards /pop and /health.
# Local backend (npm run dev in the repo root):
# VITE_PROXY_TARGET=http://localhost:4000
# Deployed AWS API Gateway:
# VITE_PROXY_TARGET=https://kv52udsb85.execute-api.us-east-1.amazonaws.com

# The future workflow orchestrator. Not used yet — see
# src/services/HttpWorkflowService.ts.
# VITE_ORCHESTRATOR_URL=
